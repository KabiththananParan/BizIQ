# Copy this file to .env and replace the placeholder before running authentication.
JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
FAILED_LOGIN_THRESHOLD=5
ACCESS_DENIED_THRESHOLD=3
UNIQUE_IP_THRESHOLD=2
LOGIN_FREQUENCY_THRESHOLD=10
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
BIZIQ_SERVICE_TOKEN_NLP_AGENT=
BIZIQ_SERVICE_TOKEN_IR_AGENT=
BIZIQ_SERVICE_TOKEN_INSIGHT_AGENT=
BIZIQ_SERVICE_TOKEN_SECURITY_AGENT=
