# Any OpenAI-compatible API works. Leave LLM_API_KEY empty to run in MOCK mode (no key needed).
# Groq (free tier):   https://api.groq.com/openai/v1   model: llama-3.3-70b-versatile
# Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai   model: gemini-2.0-flash
# Ollama (local):     http://localhost:11434/v1        model: llama3.1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
DB_PATH=insights.db
# Shared secret agreed with Member 4 (JWT HS256). Leave empty in development.
JWT_SECRET=
DEV_AUTH=true
